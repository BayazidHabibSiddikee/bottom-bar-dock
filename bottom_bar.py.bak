"""bottom_bar.py — minimal dock bar (PySide6 only, no system deps).

Left :  clock + date
Center:  CPU % · RAM %
Right :  🎵 glava toggle button (launches / kills glava)
"""
import os
import subprocess
import sys
from datetime import datetime

from PySide6.QtWidgets import QWidget
from PySide6.QtCore    import Qt, QTimer
from PySide6.QtGui     import QPainter, QColor, QFont, QFontMetrics

# ── One Dark palette ────────────────────────────────────────────────────────
BG       = QColor(40, 44, 52)
BG_HOVER = QColor(62, 68, 81)
CYAN     = QColor(97, 175, 239)
GREEN    = QColor(152, 195, 121)
DIM      = QColor(62, 68, 81)
WHITE    = QColor(171, 178, 191)
RED      = QColor(224, 108, 117)
AMBER    = QColor(229, 192, 123)

GLAVA_RC     = os.path.expanduser("~/.config/glava/rc.glsl")
GLAVA_THEME  = os.path.expanduser("~/.config/animated-wallpaper/glava.theme")
GLAVA_PID    = os.path.expanduser("~/.config/animated-wallpaper/glava.pid")


def _cpu() -> int:
    try:
        vals = list(map(int, open("/proc/stat").readline().split()[1:8]))
        idle, total = vals[3], sum(vals)
        if not hasattr(_cpu, "_p"):
            _cpu._p = (total, idle)
            return 0
        pt, pi = _cpu._p
        _cpu._p = (total, idle)
        dt, di = total - pt, idle - pi
        return int(100 * (1 - di / dt)) if dt else 0
    except Exception:
        return 0


def _mem() -> int:
    try:
        info = {}
        for line in open("/proc/meminfo"):
            k, v = line.split(":", 1)
            info[k.strip()] = int(v.split()[0])
        return int(100 * (info["MemTotal"] - info["MemAvailable"]) / info["MemTotal"])
    except Exception:
        return 0


def _glava_running() -> bool:
    """Check whether glava is currently alive via PID file."""
    try:
        pid = int(open(GLAVA_PID).read().strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _start_glava():
    """Launch glava as a transparent desktop window showing color-only spectrum."""
    # Build a minimal rc.glsl that uses the graph module with a single-color
    # gradient strip (no bar shapes, just horizontal color bands).
    rc_content = _glava_color_only_rc()
    os.makedirs(os.path.dirname(GLAVA_RC), exist_ok=True)
    tmp_rc = GLAVA_RC + ".tmp"
    with open(tmp_rc, "w") as f:
        f.write(rc_content)

    cmd = [
        "glava",
        "-d",
        "-e", tmp_rc,
        "-r", "setgeometry 0 0 1920 30",
        "-r", "setxwintype dock",
        "-r", "setopacity native",
        "-r", "setclickthrough true",
        "-r", "setfloating false",
        "-r", "setframerate 30",
        "-r", "setprintframes false",
        "-m", "graph",
    ]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.makedirs(os.path.dirname(GLAVA_PID), exist_ok=True)
    with open(GLAVA_PID, "w") as f:
        f.write(str(proc.pid))
    # Clean up temp rc after a moment
    QTimer.singleShot(500, lambda: _safe_remove(tmp_rc))


def _glava_color_only_rc() -> str:
    """Return an rc.glsl that draws a thin color-strip (no bars)."""
    return """#request mod graph
#request setfloating false
#request setdecorated false
#request setfocused false
#request setmaximized false
#request setopacity "native"
#request setmirror false
#request setversion 3 3
#request setshaderversion 330
#request settitle "GLava-Strip"
#request setgeometry 0 0 1920 30
#request setbg 00000000
#request setxwintype "dock"
#request setclickthrough true
#request setsource "auto"
#request setswap 0
#request setinterpolate true
#request setframerate 30
#request setprintframes false
#request setsamplesize 512
#request setbufsize 2048
#request setsamplerate 22050
#request setfullscreencheck false
"""


def _stop_glava():
    """Kill glava by PID, remove pid file."""
    if _glava_running():
        try:
            pid = int(open(GLAVA_PID).read().strip())
            os.kill(pid, 15)
        except Exception:
            pass
    try:
        os.remove(GLAVA_PID)
    except Exception:
        pass
    # Also kill any stray glava processes
    subprocess.run(["pkill", "-f", "^glava"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _safe_remove(path: str):
    try:
        os.remove(path)
    except Exception:
        pass


class BottomBar(QWidget):
    """Minimal dock bar with clock, stats, and glava toggle."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self._glava_on = _glava_running()
        self._hover_glava = False

        t = QTimer(self)
        t.timeout.connect(self._refresh)
        t.start(1500)
        QTimer.singleShot(100, self._refresh)

    def _refresh(self):
        self._glava_on = _glava_running()
        self.update()

    def mousePressEvent(self, e):
        x = int(e.position().x())
        if hasattr(self, "_glava_rect") and self._glava_rect:
            x0, x1 = self._glava_rect
            if x0 <= x <= x1:
                self._toggle_glava()

    def mouseMoveEvent(self, e):
        x = int(e.position().x())
        hover = bool(getattr(self, "_glava_rect", None)) and (
            self._glava_rect[0] <= x <= self._glava_rect[1]
        )
        if hover != self._hover_glava:
            self._hover_glava = hover
            self.update()

    def leaveEvent(self, e):
        if self._hover_glava:
            self._hover_glava = False
            self.update()
        super().leaveEvent(e)

    def _toggle_glava(self):
        if self._glava_on:
            _stop_glava()
        else:
            _start_glava()
        self._glava_on = _glava_running()
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        W, H = self.width(), self.height()
        p.fillRect(self.rect(), BG)

        font   = QFont("Sans Mono", 11, QFont.Bold)
        p.setFont(font)
        fm     = QFontMetrics(font)
        y      = H - (H - fm.ascent()) // 2 - 1

        # ── Left: clock + date ────────────────────────────────────────
        now  = datetime.now()
        time_str = now.strftime("%H:%M:%S")
        date_str = now.strftime("%a %d %b %Y")
        p.setPen(CYAN)
        p.drawText(10, y, time_str)
        tw = fm.horizontalAdvance(time_str)
        p.setPen(DIM)
        p.drawText(10 + tw + 6, y, "│")
        dx = 10 + tw + 10
        p.setPen(WHITE)
        p.drawText(dx, y, date_str)
        dx += fm.horizontalAdvance(date_str) + 14

        # ── Center: CPU + RAM ─────────────────────────────────────────
        cpu = _cpu()
        ram = _mem()
        cpu_col = RED if cpu >= 80 else AMBER if cpu >= 50 else GREEN
        sep = "  │  "

        p.setPen(GREEN);  p.drawText(dx, y, "⚡ CPU:")
        dx += fm.horizontalAdvance("⚡ CPU:")
        p.setPen(cpu_col); p.drawText(dx, y, f"{cpu}%")
        dx += fm.horizontalAdvance(f"{cpu}%") + 10

        p.setPen(DIM);    p.drawText(dx, y, sep)
        dx += fm.horizontalAdvance(sep)
        p.setPen(GREEN);  p.drawText(dx, y, "🧠 RAM:")
        dx += fm.horizontalAdvance("🧠 RAM:")
        p.setPen(CYAN);   p.drawText(dx, y, f"{ram}%")
        dx += fm.horizontalAdvance(f"{ram}%") + 20

        # ── Right: glava toggle button ────────────────────────────────
        btn_text  = "🎵 GLAVA ON" if self._glava_on else "🎵 GLAVA"
        btn_font  = QFont("Sans Mono", 9, QFont.Bold)
        p.setFont(btn_font)
        btn_fm    = QFontMetrics(btn_font)
        btn_w     = btn_fm.horizontalAdvance(btn_text) + 16
        btn_h     = H - 6
        btn_x     = W - btn_w - 10
        btn_y     = 3

        self._glava_rect = (btn_x, btn_x + btn_w)

        btn_bg = BG_HOVER.lighter(125) if self._hover_glava else BG_HOVER
        p.setPen(Qt.NoPen)
        p.setBrush(btn_bg)
        p.drawRoundedRect(btn_x, btn_y, btn_w, btn_h, 3, 3)

        btn_fg = CYAN if self._glava_on else WHITE
        p.setPen(btn_fg)
        p.drawText(btn_x + 8, y, btn_text)

        p.end()
